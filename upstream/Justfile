set shell := ["bash", "-euo", "pipefail", "-c"]

project-root := source_directory()
repo-root := project-root / ".."
pins := project-root / "pins.env"

# Images, host tools and the controller install manifest come from signed
# upstream releases pinned in pins.env.

# Verify the signed image digests against their release source commits.
verify-images:
    . "{{ pins }}"; \
    gh attestation verify "oci://$FIBERD_IMAGE" \
      --repo "$FIBERD_REPOSITORY" \
      --signer-workflow "$FIBERD_REPOSITORY/.github/workflows/release.yml" \
      --source-digest "$FIBERD_COMMIT" --deny-self-hosted-runners; \
    gh attestation verify "oci://$CONTROLLER_IMAGE" \
      --repo "$CONTROLLER_REPOSITORY" \
      --signer-workflow "$CONTROLLER_REPOSITORY/.github/workflows/release.yml" \
      --source-digest "$CONTROLLER_COMMIT" --deny-self-hosted-runners

# Download one checksum-pinned, attested upstream release asset.
[no-cd]
[positional-arguments]
[private]
release-asset repository commit version asset checksum output:
    repository=$1; commit=$2; version=$3; asset=$4; checksum=$5; \
    output=$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().resolve())' "$6"); \
    mkdir -p "$(dirname "$output")"; \
    work=$(mktemp -d "$(dirname "$output")/.upstream-asset.XXXXXX"); \
    trap 'rm -rf -- "$work"' EXIT; \
    download="$work/$asset"; \
    curl --fail --silent --show-error --location --output "$download" \
      "https://github.com/$repository/releases/download/v$version/$asset"; \
    actual=$(python3 -c 'import hashlib,sys; digest=hashlib.sha256(); source=open(sys.argv[1],"rb"); [digest.update(chunk) for chunk in iter(lambda: source.read(1048576), b"")]; print(digest.hexdigest())' "$download"); \
    [[ $actual == "$checksum" ]] || { \
      echo "$asset has SHA-256 $actual, not the pinned $checksum" >&2; exit 1; }; \
    gh attestation verify "$download" \
      --repo "$repository" \
      --signer-workflow "$repository/.github/workflows/release.yml" \
      --source-digest "$commit" --deny-self-hosted-runners >/dev/null; \
    install -m 0644 "$download" "$output"

# Extract zygotectl and grant-issuer for one release platform.
[no-cd]
[positional-arguments]
template-tools-target target:
    . "{{ pins }}"; target=$1; \
    case "$target" in \
      darwin-amd64) os=darwin; arch=amd64; checksum=$FIBERD_ARCHIVE_DARWIN_AMD64_SHA256 ;; \
      darwin-arm64) os=darwin; arch=arm64; checksum=$FIBERD_ARCHIVE_DARWIN_ARM64_SHA256 ;; \
      linux-amd64) os=linux; arch=amd64; checksum=$FIBERD_ARCHIVE_LINUX_AMD64_SHA256 ;; \
      linux-arm64) os=linux; arch=arm64; checksum=$FIBERD_ARCHIVE_LINUX_ARM64_SHA256 ;; \
      *) echo "unsupported fiberd tool target: $target" >&2; exit 1 ;; \
    esac; \
    asset="fiberd_${FIBERD_VERSION}_${os}_${arch}.tar.gz"; \
    parent="{{ repo-root }}/build/template-tools"; \
    mkdir -p "$parent"; \
    work=$(mktemp -d "$parent/.fiberd-tools.XXXXXX"); \
    trap 'rm -rf -- "$work"' EXIT; \
    archive="$work/$asset"; \
    just --justfile "{{ project-root }}/Justfile" release-asset \
      "$FIBERD_REPOSITORY" "$FIBERD_COMMIT" "$FIBERD_VERSION" \
      "$asset" "$checksum" "$archive"; \
    mkdir "$work/out"; \
    tar --extract --gzip --file "$archive" --directory "$work/out" \
      ./zygotectl ./grant-issuer; \
    for tool in zygotectl grant-issuer; do \
      [[ -f $work/out/$tool ]] || { echo "$asset has no $tool" >&2; exit 1; }; \
      chmod 0755 "$work/out/$tool"; \
    done; \
    destination="$parent/$target"; \
    rm -rf -- "$destination"; \
    mv "$work/out" "$destination"

# Prepare the tools carried by the Linux/amd64 and macOS/arm64 platforms.
template-tools:
    for target in linux-amd64 darwin-arm64; do \
      just --justfile "{{ project-root }}/Justfile" template-tools-target "$target"; \
    done

# Download the controller's published install manifest and, for local cluster

# suites, replace only its verified release image with the loaded local tag.
[no-cd]
[positional-arguments]
controller-manifest image output:
    . "{{ pins }}"; image=$1; \
    output=$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().resolve())' "$2"); \
    [[ $image == *@sha256:* || ${image##*/} == *:* ]] || { \
      echo "controller image needs a tag or digest: $image" >&2; exit 1; }; \
    mkdir -p "$(dirname "$output")"; \
    work=$(mktemp -d "$(dirname "$output")/.controller-manifest.XXXXXX"); \
    trap 'rm -rf -- "$work"' EXIT; \
    source="$work/install.yaml"; \
    just --justfile "{{ project-root }}/Justfile" release-asset \
      "$CONTROLLER_REPOSITORY" "$CONTROLLER_COMMIT" "$CONTROLLER_VERSION" \
      install.yaml "$CONTROLLER_MANIFEST_SHA256" "$source"; \
    python3 -c 'from pathlib import Path; import sys; source=Path(sys.argv[1]).read_text(); old="image: "+sys.argv[2]; count=source.count(old); count == 1 or sys.exit(f"published controller manifest names its pinned image {count} times"); Path(sys.argv[4]).write_text(source.replace(old, "image: "+sys.argv[3]))' \
      "$source" "$CONTROLLER_IMAGE" "$image" "$work/output.yaml"; \
    grep -Fq "image: $image" "$work/output.yaml" || { \
      echo "the manifest does not run $image" >&2; exit 1; }; \
    mv "$work/output.yaml" "$output"

# build/controller-inputs.json names build/fiberd-k8s-controller.yaml, which
# runs `controller-image`, and the digest-pinned grant and helper images.
# Packaging adds both files when they exist, and ly cluster install takes
# each input an install is not given from them.

# Write the controller inputs a platform package installs by default.
[positional-arguments]
controller-inputs controller-image grant-image helper-image: verify-images
    for image in "$1" "$2" "$3"; do \
      [[ $image =~ ^[^@[:space:]]+@sha256:[0-9a-f]{64}$ ]] || { echo "not pinned by a sha256 digest: $image" >&2; exit 1; }; \
    done
    just --justfile "{{ project-root }}/Justfile" controller-manifest "$1" "{{ repo-root }}/build/fiberd-k8s-controller.yaml"
    jq -n --arg grantImage "$2" --arg helperImage "$3" \
      '{controllerManifest:"build/fiberd-k8s-controller.yaml",grantImage:$grantImage,helperImage:$helperImage}' \
      > "{{ repo-root }}/build/controller-inputs.json"

# The cluster suites take this directory as LAMPYR_CLUSTER_INPUTS in place
# of published inputs: the upstream fiberd and helper images as OCI layouts,
# the controller image as a Docker archive, the verified published manifest,
# and the helper plus upstream host tools.

# Build the cluster suites' controller inputs into `output`.
[no-cd]
[positional-arguments]
cluster-inputs output: verify-images
    just --justfile "{{ repo-root }}/Justfile" helper::prepare-image
    just --justfile "{{ project-root }}/Justfile" template-tools-target linux-amd64
    just --justfile "{{ repo-root }}/Justfile" providers::install-oras
    . "{{ pins }}"; \
    name=$(basename -- "$1"); \
    [[ $name != . && $name != .. && $name != / ]] || { \
      echo "refusing to replace $1: name the inputs directory itself" >&2; exit 1; }; \
    parent=$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().resolve())' "$(dirname -- "$1")"); \
    output="$parent/$name"; \
    if [[ -e $output || -L $output ]]; then \
      [[ -d $output && ! -L $output && -r $output && -x $output ]] || { \
        echo "refusing to replace $output: it is a symbolic link or not a directory this user can read" >&2; exit 1; }; \
      entries=$(ls -A -- "$output"); \
      [[ -f $output/inputs.json || -z $entries ]] || { \
        echo "refusing to replace $output: it is neither empty nor earlier cluster inputs" >&2; exit 1; }; \
    fi; \
    mkdir -p -- "$(dirname -- "$output")"; \
    staging=$(mktemp -d "$(dirname -- "$output")/.cluster-inputs.XXXXXX"); \
    trap 'rm -rf -- "$staging"' EXIT; \
    chmod 0755 "$staging"; \
    mkdir -p "$staging/images" "$staging/bin"; \
    controller="lampyr.local/fiberd-k8s-controller:${CONTROLLER_COMMIT:0:12}"; \
    controller_digest=$("{{ repo-root }}/build/tools/oras" resolve --platform linux/amd64 "$CONTROLLER_IMAGE"); \
    controller_source="${CONTROLLER_IMAGE%@*}@$controller_digest"; \
    docker pull --platform linux/amd64 "$controller_source"; \
    docker tag "$controller_source" "$controller"; \
    docker save --output "$staging/images/fiberd-k8s-controller.tar" "$controller"; \
    docker buildx build --platform linux/amd64 --provenance=false \
      --output "type=oci,dest=$staging/images/hluk-helper,tar=false" \
      --file "{{ repo-root }}/helper/ci.Dockerfile" "{{ repo-root }}"; \
    "{{ repo-root }}/build/tools/oras" cp --platform linux/amd64 --to-oci-layout \
      "$FIBERD_IMAGE" "$staging/images/upstream-fiberd:ci"; \
    digest() { \
      jq -er '.manifests | select(length == 1) | .[0].digest | select(test("^sha256:[0-9a-f]{64}$"))' \
        "$staging/images/$1/index.json"; \
    }; \
    grant_digest=$(digest upstream-fiberd); \
    helper_digest=$(digest hluk-helper); \
    install -m 0755 "{{ repo-root }}/build/hluk-helper" "$staging/bin/hluk-helper"; \
    for tool in zygotectl grant-issuer; do \
      install -m 0755 "{{ repo-root }}/build/template-tools/linux-amd64/$tool" "$staging/bin/$tool"; \
    done; \
    just --justfile "{{ project-root }}/Justfile" controller-manifest "$controller" "$staging/fiberd-k8s-controller.yaml"; \
    jq -n --arg controllerImage "$controller" --arg grantDigest "$grant_digest" --arg helperDigest "$helper_digest" \
      '{controllerImage:$controllerImage,grantDigest:$grantDigest,helperDigest:$helperDigest}' > "$staging/inputs.json"; \
    rm -rf -- "$output"; \
    mv -- "$staging" "$output"
