# Upstream releases. Image indexes have signed GitHub provenance from each
# repository's release workflow. Keep plain NAME=value lines for bash and tests.

# The fiberd grant Pods run, and whose zygotectl and grant-issuer seal
# templates. go.mod's github.com/Azure/fiberd must be this commit too,
# since the router's client speaks its protocol.
FIBERD_REPOSITORY=Azure/fiberd
FIBERD_COMMIT=582d65676908569f27be209689a45a34a7fbd875
FIBERD_VERSION=0.4.0
FIBERD_IMAGE=ghcr.io/azure/fiberd@sha256:672ff23e18557076bee7c6a1f6da3e95802eab1cafcd4720d62a2f7466779305
FIBERD_ARCHIVE_DARWIN_AMD64_SHA256=06564bb432d5445867b5109a3a6e97689f06aa87d9e47999b7bbbaea1fa77d97
FIBERD_ARCHIVE_DARWIN_ARM64_SHA256=478c388755b69b245c457217b9515ac0b3fc2d7bc5ccac103dcd1a264f346534
FIBERD_ARCHIVE_LINUX_AMD64_SHA256=f6a940bada65e28a46e0ff9d4937d26dcc955b3fad2641412259ef594d93b7d3
FIBERD_ARCHIVE_LINUX_ARM64_SHA256=3a298e82a9319630801253433b473b22792ec37d56dbeb2888af7af0385d3f0d

# Build the install manifest from this release's source, with the same
# image digest. The manifest includes both Grant CRDs and admission policies.
CONTROLLER_REPOSITORY=Azure/fiberd-k8s-controller
CONTROLLER_COMMIT=8f799dff34ddc00c333f763c34c643ce8829ec29
CONTROLLER_VERSION=0.1.0
CONTROLLER_IMAGE=ghcr.io/azure/fiberd-k8s-controller@sha256:f5c638fb08314ed1ea29e01eb113ad6abf1e8f999980d57d426975ba4dbf5d51
CONTROLLER_MANIFEST_SHA256=73f5e45dc329897528d589439aa55a850854ba7fb21f04180af3812baeb94485
