# The upstream commits Lampyr builds fiberd's image and
# fiberd-k8s-controller's image and install manifest from, until those
# projects publish releases of their own. Bump a commit here and every
# build follows it. Keep to plain NAME=value lines: bash sources this file
# and the release tests parse it.

# The fiberd grant Pods run, and whose zygotectl and grant-issuer seal
# templates. go.mod's github.com/Azure/fiberd must be this commit too,
# since the router's client speaks its protocol.
FIBERD_REPOSITORY=Azure/fiberd
FIBERD_COMMIT=549f6168ca09b61da6686338efb27644d7fc33a0

# Azure/fiberd-k8s-controller main at #39's merge, which serves grant
# Pods over mutual TLS, issues caller grants and leaves a CPU request
# without a limit.
CONTROLLER_REPOSITORY=Azure/fiberd-k8s-controller
CONTROLLER_COMMIT=5d57bd8312c4fe6cf4446c474ad7d4a3166967d2
