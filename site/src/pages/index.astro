---
import RequestJourney from '../components/RequestJourney.astro';
import SiteShell from '../layouts/SiteShell.astro';

const base = import.meta.env.BASE_URL;
const quickstart = `git clone https://github.com/hyperlight-dev/lampyr.git
cd lampyr
just build-ly kind::build cli::runtime-images
build/ly scaffold workspace demo-workspace
build/ly cluster install --provider kind --workspace demo-workspace --allow-docker
build/ly dev --port 8080 demo-workspace
curl http://app.default.localhost:8080/test`;
---

<SiteShell
	title="Lampyr: Small services. Bright starts."
	description="Familiar applications with hardware-isolated activation and a serverless-like Kubernetes workflow."
>
	<section class="hero section">
		<div class="hero-copy">
			<h1>Small services.<br /><em>Bright starts.</em></h1>
			<p class="lede">
				Run familiar applications in short-lived Hyperlight microVMs. Lampyr brings
				hardware-isolated activation, scale-to-zero execution, and a compact deployment
				workflow to Kubernetes.
			</p>
			<div class="actions">
				<a class="button primary" href={`${base}walkthrough/`}>Get started</a>
				<a class="button" href={`${base}docs/`}>Read the docs</a>
				<a class="text-link" href="https://github.com/hyperlight-dev/lampyr"
					>View on GitHub <span aria-hidden="true">↗</span></a
				>
			</div>
		</div>
		<div class="hero-mark" aria-hidden="true">
			<div class="orbit orbit-one"></div>
			<div class="orbit orbit-two"></div>
			<img src={`${base}favicon.svg`} alt="" width="250" height="250" />
			<span class="annotation annotation-a">restore / serve / release</span>
		</div>
	</section>

	<section class="section" aria-labelledby="why-heading">
		<div class="section-heading">
			<h2 id="why-heading">A smaller path from source to isolated execution.</h2>
		</div>
		<div class="feature-grid">
			<article>
				<h3>Familiar applications</h3>
				<p>
					Use ordinary HTTP servers or supported language adapters for Node.js, Python, Go,
					Rust, and .NET.
				</p>
			</article>
			<article>
				<h3>Hardware isolation</h3>
				<p>
					Application execution stays inside Hyperlight microVMs with immutable, pre-admitted
					configuration.
				</p>
			</article>
			<article>
				<h3>Idle execution reaches zero</h3>
				<p>
					No service-specific running instance is required while idle; shared infrastructure
					remains ready.
				</p>
			</article>
			<article>
				<h3>Capability-based execution</h3>
				<p>
					Pre-admitted policies define network and filesystem access. Grants authorize
					execution within resource and capacity limits.
				</p>
			</article>
		</div>
	</section>

	<section class="section" aria-labelledby="journey-heading">
		<div class="section-heading split-heading">
			<div>
				<h2 id="journey-heading">How a request is handled</h2>
			</div>
			<p>
				Ingress routes the request, fiber-router finds the home admitted for its revision, and
				fiberd restores a prepared microVM. When work finishes, that instance disappears.
			</p>
		</div>
		<RequestJourney />
	</section>

	<section class="section workflow" aria-labelledby="workflow-heading">
		<div class="section-heading">
			<h2 id="workflow-heading">Build from source, then start locally.</h2>
			<p>
				The current release workflow does not publish downloadable CLI or platform archives.
				Start with the verified repository path and a local Kind cluster.
			</p>
		</div>
		<div class="code-panel">
			<div class="code-toolbar">
				<span>source-build quickstart</span>
				<button type="button" data-copy-target="quickstart-code">Copy</button>
			</div>
			<pre id="quickstart-code"><code>{quickstart}</code></pre>
			<nav class="workflow-links" aria-label="Quickstart resources">
				<a href={`${base}contributing/#prerequisites`}>Check prerequisites</a>
				<a href={`${base}cluster-kind/`}>Kind cluster guide</a>
				<a href={`${base}cli/`}>CLI reference</a>
			</nav>
		</div>
	</section>

	<section class="section runtime-catalog" aria-labelledby="compatibility-heading">
		<div class="section-heading split-heading">
			<div>
				<h2 id="compatibility-heading">Supported languages and runtimes</h2>
			</div>
			<div>
				<p>
					Protocol coverage varies by runtime. Use the compatibility matrix to choose a
					template and understand its limitations.
				</p>
				<a class="text-link" href={`${base}runtime-compatibility/`}>Compare protocol support</a>
			</div>
		</div>
		<ul class="runtime-grid" aria-label="Supported languages and runtimes">
			<li><strong>JavaScript / Node.js</strong></li>
			<li><strong>Python</strong></li>
			<li><strong>Go</strong></li>
			<li><strong>Rust</strong></li>
			<li><strong>C# / .NET</strong></li>
		</ul>
	</section>

	<section class="section" aria-labelledby="open-projects-heading">
		<div class="section-heading split-heading">
			<h2 id="open-projects-heading">Built on open projects</h2>
			<p>Lampyr builds on the work of these open-source projects and their communities.</p>
		</div>
		<ul class="project-grid">
			<li><a href="https://github.com/hyperlight-dev/hyperlight" class="text-link">Hyperlight</a><p>Hardware-isolated microVM execution.</p></li>
			<li><a href="https://unikraft.org/" class="text-link">Unikraft</a><p>Unikernel application foundations.</p></li>
			<li><a href="https://github.com/Azure/fiberd" class="text-link">fiberd</a><p>Node-local activation and Fiber lifecycle.</p></li>
			<li><a href="https://knative.dev/" class="text-link">Knative</a><p>Serving, routing, and event delivery.</p></li>
		</ul>
	</section>

	<footer class="footer section">
		<div>
			<h2>Build a small service.<br />Keep the boundary strong.</h2>
		</div>
		<div class="footer-links">
			<a href={`${base}docs/`}>Documentation</a>
			<a href="https://github.com/hyperlight-dev/lampyr">Source</a>
			<a href="https://github.com/hyperlight-dev/lampyr/issues">Issues</a>
			<a href={`${base}contributing/`}>Contribute</a>
		</div>
	</footer>

	<script>
		for (const button of document.querySelectorAll('[data-copy-target]')) {
			button.addEventListener('click', async () => {
				if (!(button instanceof HTMLButtonElement)) return;
				const target = document.getElementById(button.dataset.copyTarget ?? '');
				if (!target) return;
				await navigator.clipboard.writeText(target.textContent ?? '');
				button.textContent = 'Copied';
				window.setTimeout(() => {
					button.textContent = 'Copy';
				}, 1600);
			});
		}
	</script>
</SiteShell>
