FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS dependencies
COPY .lampyr-adapter/requirements.txt /requirements.txt
RUN pip install --no-cache-dir --no-compile --require-hashes --only-binary=:all: --target /site-packages -r /requirements.txt

FROM hluk-python-rootfs:latest AS rootfs

COPY --from=dependencies /site-packages /site-packages
COPY .lampyr-adapter/server.py /entrypoint.py
COPY handler.py /handler.py
COPY .lampyr-adapter/lampyr_types.py /lampyr_types.py
ARG LAMPYR_REQUIRE_EVENT=0
ENV LAMPYR_REQUIRE_EVENT=${LAMPYR_REQUIRE_EVENT}
RUN ["/usr/local/bin/python3", "/entrypoint.py", "--check"]
