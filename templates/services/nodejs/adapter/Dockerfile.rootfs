FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS dependencies
WORKDIR /adapter
COPY .lampyr-adapter/package.json .lampyr-adapter/package-lock.json ./
RUN npm ci --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund

FROM hluk-node-rootfs:latest AS rootfs

COPY --from=dependencies /adapter/node_modules /node_modules
COPY .lampyr-adapter/server.js /entrypoint.js
COPY handler.js /handler.js
COPY .lampyr-adapter/types.js /.lampyr-adapter/types.js
ARG LAMPYR_REQUIRE_EVENT=0
ENV LAMPYR_REQUIRE_EVENT=${LAMPYR_REQUIRE_EVENT}
RUN ["/usr/bin/node", "/entrypoint.js", "--check"]
