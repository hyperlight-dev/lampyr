FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS dependencies

WORKDIR /adapter
COPY .lampyr-adapter/package.json .lampyr-adapter/package-lock.json ./
RUN npm ci --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

WORKDIR /app
COPY --from=dependencies /adapter/node_modules .lampyr-adapter/node_modules
COPY .lampyr-adapter/server.js .lampyr-adapter/types.js .lampyr-adapter/
COPY handler.js ./

ENV PORT=8080
USER node
ENTRYPOINT ["node", ".lampyr-adapter/server.js"]
